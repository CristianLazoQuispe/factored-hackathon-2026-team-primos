#!/bin/sh
# Same lint as the `test` job in .github/workflows/deploy.yml: a commit that would fail CI fails here.
# Enabled per clone by `make setup` (git config core.hooksPath .githooks).
set -e
cd "$(git rev-parse --show-toplevel)"
uv run ruff check app tests data_pipeline
uv run ruff format --check app tests data_pipeline
