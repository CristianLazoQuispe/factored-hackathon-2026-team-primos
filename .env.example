# ---------- App ----------
APP_ENV=local
LOG_LEVEL=INFO
# Signs the API bearer tokens. Outside local it must be random, 32+ chars: openssl rand -hex 32
JWT_SECRET=change-me-local-only-not-for-production
# Opens the operator console (web /crm). Outside local it must be random, 32+ chars.
OPERATOR_KEY=change-me-local-only-operator-key
PUBLIC_BASE_URL=http://localhost:8080
# Customers offered in the chat UI and allowed to start a demo session (POST /api/auth/token). Synthetic data only.
# Khipear (the agent prepares transfers and payments; the customer confirms). Needs a core loaded
# with account numbers and ops.transfers: `make db-load`. false = a transfer is refused.
KHIPU_ENABLED=true
DEMO_CUSTOMER_IDS=CLI-NRO6HF74BFQD,CLI-N71MY63F94EZ,CLI-HEZJTWU5SMDG,CLI-06IPRRS0DV7R,CLI-B1E9XR629AA8,CLI-Q8PA9Y954XOF,DEMO-MX-KHIPU

# ---------- Data: LATAM Bank dataset (S3, read-only) ----------
# Credentials are in the "LATAM Bank Complete Data Dictionary" PDF. Never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=factored-datathon-2026-s3-157725502942-us-east-2-an
S3_PREFIX=data/
DATA_DIR=./data

# ---------- Agent operational store (local Postgres from docker compose) ----------
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# ---------- LLM ----------
# Empty = automatic: APP_ENV=local -> Ollama (qwen3.5:4b, run `make llm`), otherwise Gemini (gemini-2.5-flash).
# Set LLM_PROVIDER=google_genai to use Gemini locally (e.g. for evals).
LLM_PROVIDER=
LLM_MODEL_FAST=
LLM_MODEL_SMART=
OLLAMA_BASE_URL=http://localhost:11434
# Gemini: AI Studio key OR Vertex AI
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---------- Telegram (WhatsApp stand-in) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---------- Actions the customer confirms (block a card, open an inquiry, email a summary) ----------
# Off unless true. A database that already has `ops` needs
# app/adapters/outbound/postgres/migrations/001_actions.sql first.
ACTIONS_ENABLED=false
# simulated: nothing is sent, messages only go to ops.outbox. smtp: a real server, but only to DEMO_INBOXES.
MAIL_MODE=simulated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# An app password, never the account password. In Cloud Run it is the secret factored-smtp-password.
SMTP_PASSWORD=
MAIL_FROM=
# The only addresses a demo email may reach, comma-separated. The customers' own are synthetic.
DEMO_INBOXES=

# ---------- Tracing ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ---------- Deploy (GCP: factored-api + factored-web on Cloud Run, Cloud SQL) ----------
GCP_ACCOUNT=mecatronico.lazo@gmail.com
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_SQL_INSTANCE=factored-db
# Origins allowed to call the API; `make deploy-web` sets it on Cloud Run.
CORS_ORIGINS=http://localhost:3000
